# Configuración para desarrollo local.
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# En AWS este archivo no existe ni se usa: PORT, NODE_ENV y VERSION se declaran
# como variables del contenedor, y API_KEY se inyecta desde SSM Parameter Store,
# de modo que su valor nunca aparece en el repositorio ni en la imagen.

# Puerto HTTP del servicio.
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Identificador de versión que devuelve la ruta /salud.
# El pipeline coloca aquí el SHA del commit desplegado.
VERSION=local

# Credencial que los clientes deben enviar en la cabecera `x-api-key`.
# En local vale cualquier valor; en AWS la genera Terraform.
API_KEY=clave-local-de-desarrollo
